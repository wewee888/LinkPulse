# MINIMAX_API_KEY: API key for MiniMax Large Language Model API (MiniMax-M2 / MiniMax-Text-01).
# Configure via AI Studio Secrets panel.
MINIMAX_API_KEY="YOUR_MINIMAX_API_KEY"

# MINIMAX_BASE_URL: OpenAI-compatible MiniMax chat completions base URL.
MINIMAX_BASE_URL="https://api.minimax.io/v1"

# MINIMAX_GROUP_ID: Optional MiniMax Group ID for enterprise endpoints.
MINIMAX_GROUP_ID=""

# GEMINI_API_KEY: Required for server-side AI fallback and hybrid reasoning.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
